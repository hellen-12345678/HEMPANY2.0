<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Registrarse - COFFEE HEMPANY</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>
<section class="pagina-registro">

    <!-- TEXTO IZQUIERDO -->
    <div class="registro-izquierda">

        <p class="registro-subtitulo">
            BIENVENIDO A COFFEE HEMPANY
        </p>

        <h1>
            Crea tu cuenta
        </h1>

        <p class="registro-descripcion">
            Regístrate para disfrutar de todas las opciones de COFFEE HEMPANY.
        </p>

    </div>


    <!-- FORMULARIO DERECHO -->
    <div class="registro-derecha">

        <form>

            <label for="nombre">
                Nombre completo
            </label>

            <input
                type="text"
                id="nombre"
                placeholder="Ingresa tu nombre"
                required
            >


            <label for="correo">
                Correo electrónico
            </label>

            <input
                type="email"
                id="correo"
                placeholder="Ingresa tu correo"
                required
            >


            <label for="password">
                Contraseña
            </label>

            <input
                type="password"
                id="password"
                placeholder="Crea una contraseña"
                required
            >


            <label for="confirmar">
                Confirmar contraseña
            </label>

            <input
                type="password"
                id="confirmar"
                placeholder="Confirma tu contraseña"
                required
            >


            <button type="submit">
                Registrarme
            </button>


            <p class="registro-volver">
                ¿Ya tienes una cuenta?
                <a href="login.html">Inicia sesión</a>
            </p>

        </form>

    </div>

</section>

</body>
</html>
